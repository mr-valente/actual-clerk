# --- Actual Budget --------------------------------------------------------
# The Actual server Clerk syncs with, and the budget it should open.
ACTUAL_URL=http://actual_server:5006
ACTUAL_PASSWORD=replace-with-your-actual-server-password
# Actual: Settings -> Advanced -> Sync ID
ACTUAL_BUDGET_ID=replace-with-your-budget-sync-id
# Only if your budget file is end-to-end encrypted.
# ACTUAL_ENCRYPTION_PASSWORD=
# ACTUAL_VERIFY_SSL=false

# The Docker network Actual already runs on.
ACTUAL_DOCKER_NETWORK=actual_default

# --- SimpleFIN ------------------------------------------------------------
# Read-only access used to verify that each bank link is still alive. Leave
# this unset and claim a setup token from the Connections page instead; a token
# can only be claimed once, so the UI is the safer route.
# CLERK_SIMPLEFIN_ACCESS_URL=https://user:pass@bridge.simplefin.org/simplefin

# --- Local OpenAI-compatible endpoint -------------------------------------
CLERK_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# CLERK_OPENAI_API_KEY=
CLERK_MODEL=qwen2.5:14b
# CLERK_MODEL_REASONING=medium

# --- Behaviour ------------------------------------------------------------
# Clerk files what it is confident about and queues the rest for review.
# Set to `review` to have it propose everything instead.
# CLERK_APPLY_MODE=review
# CLERK_CATEGORIZATION_ENABLED=false
# CLERK_AI_ENABLED=false

# Committed category groups: the ones holding your recurring bills. Leave this
# unset and Clerk treats any category you budgeted this month as committed,
# which is what the docs/ setup guides describe.
# CLERK_COMMITTED_GROUPS=Bills,Housing

# A fixed monthly income, if yours does not land in Actual as income.
# CLERK_MONTHLY_INCOME=4200
# CLERK_CURRENCY=USD

# --- Schedule -------------------------------------------------------------
# TZ sets the time zone for the digest and for "since the 1st of the month".
TZ=America/New_York

# Actual never syncs with your bank on its own; Clerk's sync run is what does
# it, on this interval. SimpleFIN refreshes each account about once a day, so
# hourly is already more often than there is new data.
# CLERK_SYNC_INTERVAL_MINUTES=60
# Set this to false to have Clerk read Actual without triggering a bank sync.
# CLERK_BANK_SYNC_ENABLED=false
# CLERK_HEALTH_INTERVAL_MINUTES=60
# CLERK_DIGEST_TIME=07:30

# --- Notifications --------------------------------------------------------
# The morning budget digest and bank-connection alerts. Pick a hard-to-guess
# topic on ntfy.sh, or point at your own server.
# CLERK_NOTIFICATIONS_ENABLED=true
# CLERK_NTFY_URL=https://ntfy.sh
# CLERK_NTFY_TOPIC=actual-clerk-random-topic
# CLERK_NTFY_TOKEN=

# Clerk lifecycle and run summaries are visible at INFO (the default).
# CLERK_LOG_LEVEL=INFO
